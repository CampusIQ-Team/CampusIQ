<%- include("partials/header", { title: "EduRisk | Admin Dashboard" }) %>

<link rel="stylesheet" href="/css/adminDashboard.css">

<%- include("partials/navbar", { activePage: "admin-dashboard" }) %>

<main class="admin-page">

    <section class="admin-hero">
      <div>
        <span class="page-tag">Admin Dashboard</span>
        <h1>Student Risk Monitoring</h1>
        <p id="dashboard-summary">Loading student risk data...</p>
      </div>
  
      <a href="/management" class="primary-btn">Manage Students</a>
    </section>
  
    <section class="stats-grid">
      <div class="stat-card">
        <p>Total Students</p>
        <h2 id="totalStudents">0</h2>
      </div>
  
      <div class="stat-card danger">
        <p>High Risk</p>
        <h2 id="highRisk">0</h2>
      </div>
  
      <div class="stat-card warning">
        <p>Medium Risk</p>
        <h2 id="mediumRisk">0</h2>
      </div>
  
      <div class="stat-card success">
        <p>Low Risk</p>
        <h2 id="lowRisk">0</h2>
      </div>
    </section>
  
    <section class="dashboard-grid">
  
      <div class="content-box">
        <div class="section-top">
          <div>
            <h2>Recent Risk Alerts</h2>
            <p>Students who need attention</p>
          </div>
          <a href="/management" class="view-btn">View All</a>
        </div>
  
        <table>
          <thead>
            <tr>
              <th>Student</th>
              <th>Email</th>
              <th>Attendance</th>
              <th>Average Mark</th>
              <th>Risk</th>
              <th>Action</th>
            </tr>
          </thead>
  
          <tbody id="recent-alerts-body">
            <tr>
              <td colspan="6">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
  
      <div class="content-box">
        <h2>Risk Distribution</h2>
  
        <div class="risk-bars">
          <div>
            <span>High Risk</span>
            <div class="bar"><div id="highBar" class="fill high-fill"></div></div>
          </div>
  
          <div>
            <span>Medium Risk</span>
            <div class="bar"><div id="mediumBar" class="fill medium-fill"></div></div>
          </div>
  
          <div>
            <span>Low Risk</span>
            <div class="bar"><div id="lowBar" class="fill low-fill"></div></div>
          </div>
        </div>
      </div>
  
    </section>
  
    <section class="content-box">
      <div class="section-top">
        <div>
          <h2>Quick Actions</h2>
          <p>Admin tools for managing CampusIQ</p>
        </div>
      </div>
  
      <div class="actions-grid">
        <a href="/management" class="action-card">
          <h3>Student Management</h3>
          <p>View, search and manage student risk records.</p>
        </a>
  
        <a href="/student-form" class="action-card">
          <h3>Add Student Data</h3>
          <p>Capture marks, attendance and support information.</p>
        </a>
  
        <a href="/risk-result" class="action-card">
          <h3>Risk Results</h3>
          <p>View calculated academic risk results.</p>
        </a>
  
        <a href="/api/admin/export/students" class="action-card">
          <h3>Export Data</h3>
          <p>Export student data for reports or Power BI.</p>
        </a>
      </div>
    </section>
  
  </main>
  
  <script src="/js/api.js"></script>
  <script src="/js/adminDashboard.js"></script>
  
  <%- include("partials/footer") %>
