<%- include("partials/header", { title: "EduRisk | Risk Result" }) %>

<link rel="stylesheet" href="/css/management.css">

<%- include("partials/navbar", { activePage: "risk-result" }) %>

<section class="management-hero">
  <div>
    <h1>Risk Result</h1>
    <p id="student-meta">Loading your latest result...</p>
  </div>
</section>

<section class="management-box">
  <div class="result-hero">
    <div class="score-ring">
      <span id="risk-score">--</span>
      <small>risk score</small>
    </div>

    <div>
      <h1 id="result-title">Loading your latest result...</h1>
      <span id="risk-level" class="risk">--</span>
    </div>
  </div>

  <hr>

  <h2>Academic Summary</h2>
  <p><strong>Average Mark:</strong> <span id="avg-mark">--</span>%</p>
  <p><strong>Attendance:</strong> <span id="attendance-value">--</span>%</p>

  <h2>Recommendations</h2>
  <ul id="recommendations-list"></ul>
</section>

<script src="/js/api.js"></script>
<script src="/js/riskResult.js"></script>

<%- include("partials/footer") %>